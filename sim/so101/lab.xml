<mujoco model="lab_bench">
  <!-- Night Shift lab bench: SO-101 (MuJoCo Menagerie, Apache-2.0) + sample tubes + racks + two cameras -->
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.85 0.85 0.85" rgb2="0.75 0.75 0.75"
      markrgb="0.9 0.9 0.9" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>

    <!-- sample tubes: standing cylinders, 2 cm wide, 3 cm tall, coloured by cap (free joints) -->
    <body name="block_red" pos="0.26 0.06 0.015">
      <freejoint name="j_red"/>
      <geom name="g_red" type="cylinder" size="0.01 0.015" rgba="0.9 0.1 0.1 1" mass="0.02" condim="3" friction="1 .03 .003"/>
    </body>
    <body name="block_green" pos="0.26 -0.02 0.015">
      <freejoint name="j_green"/>
      <geom name="g_green" type="cylinder" size="0.01 0.015" rgba="0.1 0.8 0.1 1" mass="0.02" condim="3" friction="1 .03 .003"/>
    </body>
    <body name="block_blue" pos="0.25 -0.09 0.015">
      <freejoint name="j_blue"/>
      <geom name="g_blue" type="cylinder" size="0.01 0.015" rgba="0.1 0.2 0.9 1" mass="0.02" condim="3" friction="1 .03 .003"/>
    </body>

    <!-- racks: flat colored patches, no collision. red = cold rack, blue = sequencer rack. green has no rack. -->
    <geom name="bin_red"  type="box" size="0.04 0.04 0.001" pos="0.22  0.17 0.001" rgba="0.9 0.3 0.3 0.6" contype="0" conaffinity="0"/>
    <geom name="bin_blue" type="box" size="0.04 0.04 0.001" pos="0.22 -0.17 0.001" rgba="0.3 0.3 0.9 0.6" contype="0" conaffinity="0"/>

    <!-- cameras: operator view (angled, can be biased by a gotcha) and verifier view (top-down, never perturbed) -->
    <camera name="operator_cam" pos="0.25 0 0.70" xyaxes="0 -1 0  1 0 0" fovy="45"/>
    <camera name="verifier_cam" pos="0.25 0 0.75" xyaxes="0 -1 0  1 0 0" fovy="45"/>
  </worldbody>
</mujoco>
